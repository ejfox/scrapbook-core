{
  "name": "scrapbook-core",
  "version": "1.2.0",
  "description": "A comprehensive personal knowledge management system for digital ephemera",
  "main": "index.mjs",
  "scripts": {
    "dev": "node scripts/index.mjs --all --new-only",
    "start": "node scripts/index.mjs --all --new-only",
    "test": "node test-packages.mjs",
    "fetch:all": "node scripts/index.mjs --all",
    "fetch:pinboard": "node scripts/index.mjs --pinboard",
    "fetch:mastodon": "node scripts/index.mjs --mastodon",
    "fetch:arena": "node scripts/index.mjs --arena",
    "fetch:github": "node scripts/index.mjs --github",
    "dashboard": "node scripts/api-server.mjs",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:preview": "npm --prefix dashboard run preview",
    "doctor": "node scripts/scrap_doctor.mjs",
    "doctor:diagnose": "node scripts/scrap_doctor.mjs diagnose",
    "doctor:repair": "node scripts/scrap_doctor.mjs repair",
    "doctor:repair-ids": "node scripts/scrap_doctor.mjs repair --ids",
    "doctor:status": "node scripts/scrap_doctor.mjs status",
    "health": "node scripts/health_check.mjs",
    "validate:env": "node scripts/validate_env.mjs",
    "validate": "node tests/validate_processing.mjs",
    "audit": "node scripts/audit_fields.mjs",
    "graph:preview": "node scripts/preview_graph_projection.mjs",
    "graph:backfill": "node scripts/backfill_graph_v1.mjs",
    "graph:wikidata": "node scripts/resolve_wikidata.mjs",
    "relationships:batch": "node scripts/build_relationship_review_batch.mjs",
    "relationships:reextract": "node scripts/reextract_relationships_v2.mjs",
    "relationships:summary": "node scripts/summarize_relationship_review_batch.mjs",
    "relationships:bakeoff": "node scripts/bakeoff_relationship_models.mjs",
    "relationships:rejudge": "node scripts/rejudge_relationship_bakeoff.mjs",
    "relationships:report": "node scripts/render_relationship_bakeoff_report.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "knowledge-management",
    "digital-ephemera",
    "pinboard",
    "mastodon",
    "are.na",
    "github",
    "alfred-workflow"
  ],
  "author": "EJ Fox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ejfox/scrapbook-core.git"
  },
  "bugs": {
    "url": "https://github.com/ejfox/scrapbook-core/issues"
  },
  "homepage": "https://github.com/ejfox/scrapbook-core#readme",
  "alfred": {
    "workflow": {
      "name": "Scrapbook Search",
      "description": "Search your personal scrapbook database",
      "readme": "Alfred workflow for quick access to your digital scraps",
      "website": "https://github.com/ejfox/scrapbook-core",
      "version": "1.0.0"
    }
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@danielxceron/youtube-transcript": "^1.2.3",
    "@mozilla/readability": "^0.6.0",
    "@octokit/rest": "^21.0.1",
    "@scrapbook/content-geolocation": "file:./packages/content-geolocation",
    "@scrapbook/content-summarization": "file:./packages/content-summarization",
    "@scrapbook/entity-extraction": "file:./packages/entity-extraction",
    "@scrapbook/financial-analysis": "file:./packages/financial-analysis",
    "@sendgrid/mail": "^8.1.4",
    "@supabase/supabase-js": "^2.43.4",
    "@web-std/form-data": "^3.1.0",
    "are.na": "^0.1.5",
    "axios": "^1.7.7",
    "axios-rate-limit": "^1.4.0",
    "better-sqlite3": "^12.6.2",
    "bottleneck": "^2.19.5",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0-rc.12",
    "chroma-js": "^2.4.2",
    "cloudinary": "^2.5.1",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "filereader": "^0.10.3",
    "form-data": "^4.0.1",
    "formdata-polyfill": "^4.0.10",
    "get-image-colors": "^4.0.1",
    "html-entities": "^2.6.0",
    "inquirer": "^9.2.22",
    "js-md5": "^0.8.3",
    "jsdom": "^27.1.0",
    "llama-tokenizer-js": "^1.2.1",
    "marked": "^15.0.1",
    "masto": "^6.10.1",
    "node-cron": "^3.0.3",
    "openai": "^4.72.0",
    "ora": "^8.0.1",
    "puppeteer": "^22.15.0",
    "puppeteer-core": "^23.8.0",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "terminal-image": "^2.0.0",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.3",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0"
  }
}
