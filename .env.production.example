# Scrapbook Core Production Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# External API Keys (Optional - features will be disabled if not provided)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
NOMIC_API_KEY=your_nomic_api_key_here

# Image Storage (Optional - screenshots will be stored locally if not provided)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=scrapbook

# Email Notifications (Optional)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_email@example.com
SENDGRID_TO_EMAIL=notifications@example.com

# Social Media & Service API Keys
PINBOARD_TOKEN=your_username:your_pinboard_api_token
MASTODON_ACCESS_TOKEN=your_mastodon_access_token
MASTODON_API_URL=https://mastodon.social/api/v1
ARENA_ACCESS_TOKEN=your_arena_access_token
GITHUB_TOKEN=your_github_personal_access_token

# Application Settings
NODE_ENV=production
DEBUG=false
INSTANCE_NAME=prod-scrapbook-001

# Container Settings (automatically set by Docker)
CONTAINER_NAME=scrapbook-core
CHROME_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true